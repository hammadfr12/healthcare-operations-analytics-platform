# ---------------------------------------------------------------------------
# Healthcare Operations Analytics Platform — example environment configuration
#
# Copy to `.env` and adjust as needed:   cp .env.example .env
# Every value below has a working default, so `.env` is optional for the demo.
# No external API keys or credentials are required.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
HOA_ENVIRONMENT=development
HOA_HOST=127.0.0.1
HOA_PORT=8000
HOA_LOG_LEVEL=INFO

# --- Storage -----------------------------------------------------------------
# DuckDB file used as the local analytical store. Regenerate with `make pipeline`.
HOA_DATABASE_PATH=data/processed/healthcare_ops.duckdb

# --- Data directories (relative to the repository root) ----------------------
HOA_DATA_DIR=data
HOA_RAW_DATA_DIR=data/raw
HOA_FLAWED_DATA_DIR=data/raw/flawed
HOA_EXPORT_DIR=exports/tableau

# --- Synthetic data generation ----------------------------------------------
# Fixed seed => deterministic, reproducible demo dataset.
HOA_SYNTHETIC_SEED=20261010
# Number of trailing days of history to generate, ending on the "today" anchor.
HOA_SYNTHETIC_DAYS=365
# Anchor date for generation (YYYY-MM-DD). Leave blank to use the real current date.
HOA_SYNTHETIC_ANCHOR_DATE=2026-10-10

# --- Presentation ------------------------------------------------------------
# Timestamps are stored in UTC internally and displayed in this timezone.
HOA_FACILITY_TIMEZONE=Asia/Kolkata
# A pipeline run older than this is surfaced in the UI as "stale".
HOA_STALE_AFTER_HOURS=24

# --- Admin -------------------------------------------------------------------
# Enables POST /api/admin/refresh. Off by default: an unauthenticated rebuild
# trigger on a reachable host is a denial-of-service waiting to happen.
# Rebuild offline with `make pipeline` instead.
HOA_ADMIN_ENABLED=false

# --- Security ----------------------------------------------------------------
# Comma-separated list. Keep narrow; only the local Vite dev server by default.
HOA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Include stack traces in API error responses. MUST stay false outside local dev.
HOA_EXPOSE_ERROR_DETAIL=false
